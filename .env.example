NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# AI (server only; never prefix with NEXT_PUBLIC_). See docs/ai-api.md.
# AI_PROVIDER: "openai-compatible" (open-source model via an OpenAI-compatible
# endpoint such as the Hugging Face router) or "fixture" (contract examples,
# development only). Unset in production = AI disabled.
AI_PROVIDER=fixture
AI_BASE_URL=https://router.huggingface.co/v1
AI_API_KEY=
AI_TEXT_MODEL=
AI_JSON_MODE=false

# Foto Fokus Anak (CV service from docs/foto-fokus-anak-yolo11n-seg.ipynb).
# Local trial: http://127.0.0.1:7860. The token is the service's API_TOKEN
# (Colab secret AYOMI_CV_TOKEN). Server only; never NEXT_PUBLIC_.
CV_API_URL=
CV_API_TOKEN=

# Legal Verification: OCR service (separate repo ayomi-ocr-api on Dokploy).
# Admin > Verifikasi legalitas > "Baca dengan AI" sends the stored document
# there, then the AI_* language model picks the fields. The token is the
# service's API_TOKEN (not the CV token). Server only; never NEXT_PUBLIC_.
OCR_API_URL=
OCR_API_TOKEN=

# QR pembayaran (lib/payments/qris.js). Isi dengan string QRIS STATIS milik
# merchant (hasil scan QRIS statis, diawali 000201) agar QR berisi nominal
# tagihan. Kosong = QR demo yang tidak bisa dibayar. Server only.
QRIS_STATIC_PAYLOAD=
