  reviewed_at timestamp_with_time_zone
  reason text
  result_account_id uuid
  created_at timestamp_with_time_zone [not null]
}

Table payout_items {
  id uuid [pk]
  payout_id uuid [not null]
  charge_id uuid [not null]
  gross_amount bigint [not null]
  commission_amount bigint [not null]
  refund_deduction bigint [not null]
  other_deduction bigint [not null]
  net_amount bigint [not null]
  calculation_snapshot jsonb [not null]
  reservation_status text [not null]
  created_at timestamp_with_time_zone [not null]
}

Table payouts {
  id uuid [pk]
  daycare_id uuid [not null]
  payout_account_id uuid [not null]
  account_snapshot jsonb [not null]
  amount bigint [not null]
  currency character [not null]
  status text [not null]
  approved_by uuid
  approved_at timestamp_with_time_zone
  provider text
  provider_reference text
  idempotency_key text [not null, unique]
  paid_at timestamp_with_time_zone
  created_at timestamp_with_time_zone [not null]
  updated_at timestamp_with_time_zone [not null]
}

Table pickup_records {
  id uuid [pk]
  enrollment_id uuid [not null]
  authorization_id uuid
  collector_snapshot jsonb [not null]
  verification_status text [not null]
  verification_note text [not null]
  confirmed_by uuid [not null]
  verified_at timestamp_with_time_zone [not null]
  handed_over_at timestamp_with_time_zone
  late_minutes integer [not null]
  request_id text [not null, unique]
  created_at timestamp_with_time_zone [not null]
}

Table refunds {
  id uuid [pk]
  transaction_id uuid [not null]
  complaint_id uuid
  requested_by uuid [not null]
  decision text [not null]
  amount bigint [not null]
  reason text [not null]
  decided_by uuid
  decided_at timestamp_with_time_zone
  status text [not null]
  provider_reference text
  idempotency_key text [not null, unique]
  completed_at timestamp_with_time_zone
  created_at timestamp_with_time_zone [not null]
  updated_at timestamp_with_time_zone [not null]
}

Table report_change_logs {
  id uuid [pk]
  activity_id uuid [not null]
  changed_by uuid [not null]
  before_title text [not null]
  after_title text [not null]
  before_body text [not null]
  after_body text [not null]
  reason text [not null]
  from_version integer [not null]
  to_version integer [not null]
  created_at timestamp_with_time_zone [not null]
}

Table review_replies {
  id uuid [pk]
  review_id uuid [not null, unique]
  manager_id uuid [not null]
  published_version_id uuid
  created_at timestamp_with_time_zone [not null]
  updated_at timestamp_with_time_zone [not null]
}

Table review_reply_versions {
  id uuid [pk]
  reply_id uuid [not null]
  version integer [not null]
  body text [not null]
  status text [not null]
  draft_ai_job_id uuid
  moderation_ai_job_id uuid
  submitted_by uuid [not null]
  moderated_by uuid
  moderated_at timestamp_with_time_zone
  moderation_reason text
  created_at timestamp_with_time_zone [not null]
}

Table review_versions {
  id uuid [pk]
  review_id uuid [not null]
  version integer [not null]
  rating smallint [not null]
  body text [not null]
  moderation_status text [not null]
  ai_job_id uuid
  moderated_by uuid
  moderated_at timestamp_with_time_zone
  moderation_reason text
  created_at timestamp_with_time_zone [not null]
}

Table reviews {
  id uuid [pk]
  parent_id uuid [not null]
  daycare_id uuid [not null]
  qualifying_enrollment_id uuid [not null]
  published_version_id uuid
  revision_allowed_by uuid
  revision_complaint_id uuid
  revision_granted_at timestamp_with_time_zone
  revision_used_at timestamp_with_time_zone
  withdrawn_at timestamp_with_time_zone
  created_at timestamp_with_time_zone [not null]
  updated_at timestamp_with_time_zone [not null]
}

Table service_offerings {
  id uuid [pk]
  daycare_id uuid [not null]
  name text [not null]
  service_type text [not null]
  description text [not null]
  min_age_months integer [not null]
  max_age_months integer [not null]
  is_active boolean [not null]
  published_price_id uuid
  created_at timestamp_with_time_zone [not null]
  updated_at timestamp_with_time_zone [not null]
}

Table service_price_versions {
  id uuid [pk]
  offering_id uuid [not null]
  version integer [not null]
  service_amount bigint [not null]
  currency character [not null]
  late_pickup_terms jsonb [not null]
  status text [not null]
  proposed_by uuid [not null]
  decided_by uuid
  decided_at timestamp_with_time_zone
  decision_reason text
  effective_from timestamp_with_time_zone
  created_at timestamp_with_time_zone [not null]
  updated_at timestamp_with_time_zone [not null]
}

Table staff_invitations {
  id uuid [pk]
  daycare_id uuid [not null]
  email text [not null]
  invited_role text [not null]
  token_hash text [not null, unique]
  invited_by uuid [not null]
  expires_at timestamp_with_time_zone [not null]
  accepted_by uuid
  accepted_at timestamp_with_time_zone
  revoked_at timestamp_with_time_zone
  created_at timestamp_with_time_zone [not null]
}

Table system_settings {
  id uuid [pk]
  key text [not null]
  version integer [not null]
  value jsonb [not null]
  status text [not null]
  effective_from timestamp_with_time_zone
  approved_by uuid
  approved_at timestamp_with_time_zone
  reason text
  created_at timestamp_with_time_zone [not null]
  updated_at timestamp_with_time_zone [not null]
}

Table transactions {
  id uuid [pk]
  charge_id uuid [not null]
  provider text [not null]
  provider_transaction_id text
  idempotency_key text [not null, unique]
  method text [not null]
  amount bigint [not null]
  currency character [not null]
  status text [not null]
  reconciliation_status text [not null]
  reconciliation_reason text
  paid_at timestamp_with_time_zone
  expires_at timestamp_with_time_zone
  created_at timestamp_with_time_zone [not null]
  updated_at timestamp_with_time_zone [not null]
}

Table users {
  id uuid [pk]
  role text [not null]
  full_name text
  phone character
  status text [not null]
  created_at timestamp_with_time_zone [not null]
  updated_at timestamp_with_time_zone [not null]
  deleted_at timestamp_with_time_zone
}

Table daycare_photos {
  id uuid [pk]
  daycare_id uuid [not null]
  object_path text [not null, unique]
  caption text
  display_order smallint [not null]
  status text [not null]
  submitted_by uuid [not null]
  reviewed_by uuid
  reviewed_at timestamptz
  decision_reason text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

