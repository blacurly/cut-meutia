// Skema database Ayomi, dibuat otomatis oleh scripts/generate-erd.mjs.
// Buka di https://dbdiagram.io > Import > DBML.

TableGroup "Akun & peran" {
  users
  daycare_members
  staff_invitations
  daycare_delegations
  delegation_permissions
  account_sanctions
}

TableGroup "Daycare & katalog" {
  daycares
  daycare_listings
  daycare_listing_profiles
  daycare_photos
  service_offerings
  service_price_versions
  commission_rules
}

TableGroup "Anak" {
  children
  child_health_profiles
  child_health_change_logs
  child_health_correction_requests
}

TableGroup "Pendaftaran" {
  enrollments
  enrollment_service_dates
  enrollment_consents
  enrollment_status_logs
  caregiver_assignments
}

TableGroup "Pembayaran" {
  charges
  transactions
  payment_details
  payment_webhook_events
  refunds
  financial_holds
  payouts
  payout_items
  daycare_payout_accounts
  payout_account_change_requests
}

TableGroup "Catatan harian & media" {
  daily_reports
  daily_report_activities
  activity_comments
  activity_reactions
  activity_acknowledgements
  report_change_logs
  attachments
  attachment_variants
}

TableGroup "Penjemputan" {
  authorized_pickups
  pickup_records
}

TableGroup "Insiden" {
  incident_reports
  incident_ai_analyses
  incident_urgency_change_logs
  incident_status_logs
  incident_parent_acknowledgements
}

TableGroup "Legalitas & Safety Score" {
  daycare_documents
  daycare_verifications
  daycare_safety_scores
}

TableGroup "Ulasan" {
  reviews
  review_versions
  review_replies
  review_reply_versions
}

TableGroup "Komplain & investigasi" {
  complaints
  complaint_status_logs
  complaint_assignments
  investigations
  admin_actions
}

TableGroup "Notifikasi" {
  notifications
  notification_receipts
  notification_reminders
  notification_delivery_logs
}

TableGroup "AI, sistem & audit" {
  ai_jobs
  system_settings
  audit_logs
}

Table account_sanctions {
  id uuid [pk]
  target_user_id uuid
  target_daycare_id uuid
  investigation_id uuid
  sanction_type text [not null]
  reason text [not null]
  imposed_by uuid [not null]
  starts_at timestamp_with_time_zone [not null]
  ends_at timestamp_with_time_zone
  revoked_by uuid
  revoked_at timestamp_with_time_zone
  revocation_reason text
  created_at timestamp_with_time_zone [not null]
}

Table activity_acknowledgements {
  id uuid [pk]
  activity_id uuid [not null]
  user_id uuid [not null]
  ack_type text [not null]
  acknowledged_at timestamp_with_time_zone [not null]
}

Table activity_comments {
  id uuid [pk]
  activity_id uuid [not null]
  author_id uuid [not null]
  author_role text [not null]
  body text [not null]
  request_id text [not null]
  created_at timestamptz [not null]
  deleted_at timestamptz
}

Table activity_reactions {
  activity_id uuid [pk]
  user_id uuid [pk]
  reaction text [pk]
  created_at timestamptz [not null]
}

Table admin_actions {
  id uuid [pk]
  admin_id uuid [not null]
  action_type text [not null]
  audit_log_id uuid [not null, unique]
  complaint_id uuid
  investigation_id uuid
  decision_summary text [not null]
  executed_at timestamp_with_time_zone [not null]
}

Table ai_jobs {
  id uuid [pk]
  feature text [not null]
  daycare_id uuid
  document_id uuid
  review_version_id uuid
  reply_version_id uuid
  activity_id uuid
  attachment_id uuid
  incident_id uuid
  provider text [not null]
  model text [not null]
  model_version text [not null]
  prompt_version text [not null]
  input_version text [not null]
  input_snapshot jsonb [not null]
  output jsonb
  status text [not null]
  attempt_number integer [not null]
  retry_of_id uuid
  error_code text
  requested_by uuid
  started_at timestamp_with_time_zone
  finished_at timestamp_with_time_zone
  idempotency_key text [not null, unique]
  created_at timestamp_with_time_zone [not null]
  updated_at timestamp_with_time_zone [not null]
}

Table attachment_variants {
  id uuid [pk]
  attachment_id uuid [not null]
  variant_type text [not null]
  audience_child_id uuid
  bucket text [not null]
  object_path text [not null]
  sha256 text [not null]
  status text [not null]
  ai_job_id uuid
  reviewed_by uuid
  reviewed_at timestamp_with_time_zone
  created_at timestamp_with_time_zone [not null]
}

Table attachments {
  id uuid [pk]
  activity_id uuid
  incident_id uuid
  pickup_id uuid
  document_id uuid
  payout_change_id uuid
  complaint_id uuid
  investigation_id uuid
  sanction_id uuid
  uploaded_by uuid [not null]
  bucket text [not null]
  object_path text [not null]
  mime_type text [not null]
  byte_size bigint [not null]
  sha256 text [not null]
  status text [not null]
  uploaded_at timestamp_with_time_zone
  created_at timestamp_with_time_zone [not null]
}

Table audit_logs {
  id uuid [pk]
  actor_id uuid
  actor_type text [not null]
